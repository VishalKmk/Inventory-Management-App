spring.datasource.url=
spring.datasource.username=
spring.datasource.password=

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=
spring.jpa.show-sql=true

# JWT
app.jwt.secret=
app.jwt.expiration-ms=

# OTP
app.otp.ttl-minutes=10

# Pagination Defaults
app.pagination.default-page=0
app.pagination.default-size=20

# Mail
spring.mail.host=
spring.mail.port=
spring.mail.username=
spring.mail.password=
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# Logs
logging.level.org.springframework.security=

# OAuth
spring.security.oauth2.client.registration.google.client-id=
spring.security.oauth2.client.registration.google.client-secret=
spring.security.oauth2.client.registration.google.scope=openid,email,profile

# Where the frontend should land after successful login
app.oauth2.frontend-redirect-uri=

# Redis
spring.data.redis.host=localhost
spring.data.redis.port=6379

# Password rate limit
app.login-ratelimit.base-seconds=
app.login-ratelimit.max-seconds=
app.login-ratelimit.strike-window-minutes=

app.otp-resend.step-seconds=60,120,300,3600,86400
# How long a strike count is remembered before it resets from inactivity.
app.otp-resend.strike-window-hours=48
